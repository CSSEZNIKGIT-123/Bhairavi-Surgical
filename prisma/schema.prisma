datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  name            String
  role            String           @default("CUSTOMER") // SUPER_ADMIN, ADMIN, SALES_MANAGER, ACCOUNT_MANAGER, CUSTOMER
  phone           String?
  avatar          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  customerProfile CustomerProfile?
  businessProfile BusinessProfile?
  specialProfile  SpecialProfile?

  orders          Order[]
  quotes          Quote[]
  inquiries       SpecialInquiry[]
  consultations   Consultation[]
  reviews         Review[]
  addresses       Address[]
  cart            Cart?
  wishlist        Wishlist?
}

model CustomerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName       String?
  lastName        String?
  dateOfBirth     String?
  preferences     String?
}

model BusinessProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String
  contactPerson   String
  businessType    String?
  taxGstNumber    String?
  industry        String?
  companyAddress  String?
  creditLimit     Float    @default(0)
  accountStatus   String   @default("VERIFIED") // PENDING, VERIFIED, REJECTED
}

model SpecialProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    String?
  requirementType String?
  notes           String?
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  subtitle    String?
  description String?
  image       String?
  isFeatured  Boolean   @default(false)
  mode        String    @default("ALL") // B2B, B2C, SPECIAL, ALL
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logo        String?
  description String?
  products    Product[]
}

model Product {
  id               String       @id @default(cuid())
  title            String
  slug             String       @unique
  subtitle         String?
  description      String
  details          String?
  sku              String       @unique
  stock            Int          @default(100)
  moq              Int          @default(1) // Minimum Order Qty for B2B

  // Mode Visibility Flags
  isB2B            Boolean      @default(true)
  isB2C            Boolean      @default(true)
  isSpecial        Boolean      @default(false)

  // Pricing
  retailPrice      Float        @default(0)
  salePrice        Float?
  b2bBasePrice     Float?
  specialBasePrice Float?

  // Flags & Stats
  rating           Float        @default(5.0)
  reviewCount      Int          @default(0)
  badge            String?      // BEST SELLER, LOW LIGHT, NEW, LIMITED, ISO CERTIFIED
  isFeatured       Boolean      @default(false)
  isBestSeller     Boolean      @default(false)
  isNewArrival     Boolean      @default(false)
  
  // Visual Media (JSON stringified array of URLs)
  images           String       @default("[]") 
  specifications   String?      // JSON stringified key-values

  categoryId       String?
  category         Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId          String?
  brand            Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)

  priceTiers       PriceTier[]
  variants         ProductVariant[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  quoteItems       QuoteItem[]
  reviews          Review[]
  wishlistItems    WishlistItem[]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model PriceTier {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQty     Int
  maxQty     Int?
  unitPrice  Float
  label      String?
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  sku        String?
  price      Float?
  stock      Int      @default(50)
  attributes String?  // JSON stringified
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  mode      String     @default("B2C") // B2B or B2C
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  unitPrice Float
  mode      String   @default("B2C")
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  mode            String      @default("B2C") // B2B, B2C, SPECIAL
  status          String      @default("PENDING") // PENDING, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  totalAmount     Float
  subtotalAmount  Float
  taxAmount       Float       @default(0)
  shippingAmount  Float       @default(0)
  discountAmount  Float       @default(0)
  paymentMethod   String      @default("CREDIT_CARD") // CREDIT_CARD, PO_INVOICE, WIRE, COD
  paymentStatus   String      @default("PAID")
  
  // Customer & Shipping Snapshot
  customerName    String
  customerEmail   String
  customerPhone   String?
  companyName     String?
  poNumber        String?
  shippingAddress String
  billingAddress  String?

  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Int
  unitPrice  Float
  totalPrice Float
}

model Quote {
  id              String      @id @default(cuid())
  quoteNumber     String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  status          String      @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, QUOTED, ACCEPTED, REJECTED
  
  companyName     String
  contactPerson   String
  email           String
  phone           String
  taxId           String?
  estimatedBudget String?
  deliveryTimeline String?
  notes           String?

  offeredTotal    Float?
  adminNotes      String?
  validUntil      DateTime?

  items           QuoteItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model QuoteItem {
  id         String   @id @default(cuid())
  quoteId    String
  quote      Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Int
  targetPrice Float?
  quotedPrice Float?
}

model SpecialInquiry {
  id              String   @id @default(cuid())
  inquiryNumber   String   @unique
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name            String
  organization    String?
  email           String
  phone           String
  requirementType String   // Bespoke Suite, Titanium Custom Instrument, Turnkey OT, Private Clinic
  description     String
  urgency         String   @default("STANDARD") // IMMEDIATE, 30_DAYS, PLANNING
  status          String   @default("NEW") // NEW, CONTACTED, SCHEDULED, COMPLETED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Consultation {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  clientName      String
  clientEmail     String
  clientPhone     String
  organization    String?
  serviceType     String
  preferredDate   DateTime?
  preferredTime   String?
  notes           String?
  status          String   @default("SCHEDULED")
  createdAt       DateTime @default(now())
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String   @default("SHIPPING") // SHIPPING, BILLING
  street       String
  city         String
  state        String
  postalCode   String
  country      String   @default("India")
  isDefault    Boolean  @default(false)
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  author    String
  rating    Int      @default(5)
  title     String?
  content   String
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())
}
