# =============================================================================
# Yugan Ayurved & Panchkarma Products — Environment Configuration Template
# =============================================================================

# 1. Database Connection URL (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# 2. Authentication & JWT Secrets
JWT_SECRET="your-super-secure-jwt-secret-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# 3. Application Environment & Base URLs
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. Optional WhatsApp & Support Desk
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"
