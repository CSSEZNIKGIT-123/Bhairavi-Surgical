# =============================================================================
# Bhairavi Surgical / Yugan — Environment Configuration Template
# =============================================================================

# 1. PostgreSQL Database Connection URL (Required for Vercel Production)
# Format for Supabase / Neon / Vercel Postgres / AWS RDS / Render / Railway:
# Pooler URL (for serverless queries, port 6543 or pgbouncer):
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct URL (optional, for migrations or non-pooled connections):
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Example for Neon / Vercel Postgres:
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[EP_ID].us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Authentication & JWT Security Secrets
# Minimum 32-character high-entropy secret string for signing customer & admin session tokens:
JWT_SECRET="generate-a-strong-random-32-character-secret-key"

# Secret key required to register authorized administrative accounts:
ADMIN_INVITATION_SECRET="BHAIRAVI-ADMIN-KEY-2026"

# 3. Application Environment & URLs
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://bhairavi-surgical.vercel.app"
NEXTAUTH_URL="https://bhairavi-surgical.vercel.app"

# 4. Customer Support & WhatsApp Contact
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"

